---
/* Sección 01 — Hero.
   Composición de paraguas (pedido de dirección, ref. NEW_HERO.pdf): tres
   fotos individuales (negro/gris/amarillo) reutilizadas en 13 posiciones
   fijas — diseñadas a mano, no generadas al azar en cada carga. `loading`
   eager solo en los primeros (los que se ven al abrir sin scroll); el resto
   lazy, igual que cualquier imagen bajo el fold. */
import { Image } from 'astro:assets';
import paraguasNegro from '../../assets/img/hero-umbrellas/paraguas-negro.png';
import paraguasGris from '../../assets/img/hero-umbrellas/paraguas-gris.png';
import paraguasAmarillo from '../../assets/img/hero-umbrellas/paraguas-amarillo.png';

const FOTOS: Record<'negro' | 'gris' | 'amarillo', ImageMetadata> = {
  negro: paraguasNegro, gris: paraguasGris, amarillo: paraguasAmarillo,
};

/* top/left en % del contenedor .hero-umbrellas · rot en grados · escala
   relativa · tono = qué foto usa. El amarillo va casi al centro, por
   encima del resto (mayor z). Nada de esto se recalcula en runtime. */
const PARAGUAS: { top: number; left: number; rot: number; esc: number; z: number; tono: 'negro' | 'gris' | 'amarillo' }[] = [
  { top: 16, left: 28, rot: -8,  esc: 1.00, z: 2, tono: 'negro' },
  { top: 10, left: 54, rot: 5,   esc: 0.95, z: 3, tono: 'gris' },
  { top: 19, left: 79, rot: -4,  esc: 1.05, z: 2, tono: 'negro' },
  { top: 37, left: 14, rot: 10,  esc: 0.90, z: 3, tono: 'gris' },
  { top: 40, left: 43, rot: -12, esc: 1.05, z: 6, tono: 'amarillo' },
  { top: 35, left: 68, rot: 6,   esc: 1.00, z: 2, tono: 'negro' },
  { top: 42, left: 91, rot: -6,  esc: 0.90, z: 3, tono: 'gris' },
  { top: 60, left: 24, rot: 4,   esc: 1.00, z: 2, tono: 'negro' },
  { top: 63, left: 50, rot: -9,  esc: 0.95, z: 4, tono: 'negro' },
  { top: 58, left: 76, rot: 8,   esc: 1.05, z: 3, tono: 'gris' },
  { top: 81, left: 16, rot: -5,  esc: 0.90, z: 2, tono: 'negro' },
  { top: 83, left: 43, rot: 7,   esc: 1.00, z: 3, tono: 'gris' },
  { top: 79, left: 69, rot: -3,  esc: 0.95, z: 2, tono: 'negro' },
];
---
<section class="s-hero" id="inicio" data-theme="accent" aria-labelledby="h1">
  <span class="ghost" aria-hidden="true">01</span>
  <div class="hero-escena" data-escena="hero-particulas" data-cursor="tocar" aria-hidden="true"></div>
  <div class="c">
    <h1 id="h1" class="hero-word"><span>Bergerac</span></h1>
    <p class="t-eyebrow" data-anim-high="right, ink, 120">estudio digital · castro, chiloé</p>
  </div>
  <div class="c hero-mid">
    <div class="hero-claim">
      <p class="t-body-display hero-claim-top" data-anim-high="left, ink, 380">Tu proyecto ya tiene valor.</p>
      <p class="t-body-display" data-anim-high="left, ink, 440">Hagamos que se vea y se entienda a la altura de lo que es.</p>
      <p class="hero-bajada" data-anim-high="left, ink, 500">Bergerac estudia marcas y proyectos, detecta qué está impidiendo que su valor se vea y se entienda, y construye la identidad, la estructura y el sistema digital que necesitan para avanzar.</p>
      <div class="hero-ctas">
        <a class="btn is-solid" href="#contacto" data-magnetic data-cursor="ir"><span data-anim="text-hover">trae tu proyecto</span><svg class="btn-fl" viewBox="0 0 20 14" aria-hidden="true"><path d="M2 7h14M11 2l5 5-5 5"/></svg></a>
      </div>
    </div>
  </div>
  <div class="hero-umbrellas" aria-hidden="true">
    {PARAGUAS.map((p, i) => (
      <Image
        src={FOTOS[p.tono]}
        alt=""
        loading={i < 4 ? 'eager' : 'lazy'}
        decoding="async"
        widths={[160, 260]}
        sizes="14vw"
        class={`umbrella umbrella--${p.tono}`}
        style={`--top:${p.top}%; --left:${p.left}%; --rot:${p.rot}deg; --esc:${p.esc}; --z:${p.z}; --dur:${6 + (i % 5)}s; --delay:${(i * 0.37).toFixed(2)}s;`}
      />
    ))}
  </div>
  <div class="hero-marquee marquee-display" data-marquee data-marquee-reactive data-marquee-mouse data-marquee-speed="120" aria-hidden="true">
    <div><span>trae tu marca</span><span class="dot"></span><span>trae tu proyecto</span><span class="dot"></span><span>trae tu idea</span><span class="dot"></span></div>
  </div>
</section>

